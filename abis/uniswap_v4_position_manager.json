    "inputs": [{"name": "tokenId", "type": "uint256"}],
    "outputs": [{"name": "owner", "type": "address"}]
  },
  {
    "type": "function",
    "name": "getPositionLiquidity",
    "stateMutability": "view",
    "inputs": [{"name": "tokenId", "type": "uint256"}],
    "outputs": [{"name": "liquidity", "type": "uint128"}]
  },
  {
    "type": "function",
    "name": "getPoolAndPositionInfo",
